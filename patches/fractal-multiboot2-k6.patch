diff --git a/src/arch/x86/cpu.cc b/src/arch/x86/cpu.cc
index 982ef47..146400e 100644
--- a/src/arch/x86/cpu.cc
+++ b/src/arch/x86/cpu.cc
@@ -24,6 +24,46 @@
 
 extern FRACTALCORE_CLASS global_cpu;
 extern u64 global_multiboot_ptr;
+extern u64 global_multiboot_magic;
+
+/* K6 boot compatibility only: normalize bounded MB2 module tags to the
+ * existing MB1 interface and obtain ACPI through the bootloader on UEFI.
+ * No measured fthread, syscall or predictor path is changed. */
+static RSDPv1 *k6_boot_rsdp;
+static multiboot_info_t *k6_boot_info() {
+    if (global_multiboot_magic != 0x36d76289u)
+        return (multiboot_info_t *)KERN_P2V(global_multiboot_ptr);
+    static multiboot_info_t info;
+    static multiboot_mod_t module;
+    static bool ready;
+    if (ready) return &info;
+    const u8 *base = (const u8 *)KERN_P2V(global_multiboot_ptr);
+    u32 total = *(const u32 *)base;
+    if (total < 16 || total > (16u << 20)) panic("invalid MB2 size");
+    bool ended = false;
+    for (u32 offset = 8; offset <= total - 8;) {
+        const u8 *tag = base + offset;
+        u32 type = *(const u32 *)tag, size = *(const u32 *)(tag + 4);
+        if (size < 8 || size > total - offset) panic("invalid MB2 tag bounds");
+        if (type == 0) { if (size != 8) panic("invalid MB2 end tag"); ended = true; break; }
+        if (type == 3) {
+            if (size < 16 || info.mods_count) panic("exactly one MB2 module required");
+            module.mod_start = *(const u32 *)(tag + 8);
+            module.mod_end = *(const u32 *)(tag + 12);
+            if (module.mod_end <= module.mod_start) panic("invalid MB2 module range");
+            info.mods_count = 1;
+            info.mods_addr = (u32)((usize)&module & ~KERNEL_VIRT_MASK);
+        }
+        if ((type == 14 || type == 15) && size >= 8 + sizeof(RSDPv1)) {
+            if (!k6_boot_rsdp || type == 15) k6_boot_rsdp = (RSDPv1 *)(tag + 8);
+        }
+        offset += (size + 7u) & ~7u;
+    }
+    if (!ended || info.mods_count != 1 || !k6_boot_rsdp) panic("missing MB2 initrd or ACPI tags");
+    ready = true;
+    return &info;
+}
